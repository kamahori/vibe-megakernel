@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import os
 from dataclasses import dataclass, replace
 from pathlib import Path
 from types import MappingProxyType
@@ -187,6 +188,48 @@ def _profiler_tool(
     )
 
 
+_MEGABENCH_NCU_COMMAND_ENV = "VIBESYS_MEGABENCH_NCU_MCP_COMMAND"
+
+
+def _megabench_ncu_tool(
+    _context: object, binding: AgentToolBindingContext
+) -> tuple[ToolServerDescriptor, ...]:
+    """Attach the optional external NCU server to one multi-agent implementer."""
+    raw_command = os.environ.get(_MEGABENCH_NCU_COMMAND_ENV)
+    if not raw_command:
+        return ()
+    command = Path(raw_command).expanduser()
+    if not command.is_absolute() or not command.is_file() or not os.access(command, os.X_OK):
+        raise ConfigurationError(
+            ConfigurationDiagnostic(
+                code="megabench_ncu_mcp_command_invalid",
+                stage="agent_tool_binding",
+                message=(
+                    f"{_MEGABENCH_NCU_COMMAND_ENV} must name an absolute, executable file: "
+                    f"{raw_command}"
+                ),
+            )
+        )
+    ncu_path = os.environ.get("NCU_PATH")
+    if ncu_path:
+        selected_path = Path(ncu_path)
+        env = (
+            (
+                "NCU_PATH",
+                binding.agent_path(selected_path) if selected_path.is_absolute() else ncu_path,
+            ),
+        )
+    else:
+        env = ()
+    return (
+        StdioServerDescriptor(
+            name="ncu_mcp",
+            command=binding.agent_path(command),
+            env=env,
+        ),
+    )
+
+
