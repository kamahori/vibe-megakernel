From d7b491767d0867983f3ce2281d99d28971066fd8 Mon Sep 17 00:00:00 2001
From: Garv Ghai <garv901@gmail.com>
Date: Sun, 8 Nov 2026 16:36:41 -0800
Subject: [PATCH 5/9] Phase round prompt: foreground phase subagents, return
 only after all have returned

(cherry picked from commit 05cf66569361976a902e748926c34938cf256766)
---
 src/vibesys/orchestration/multi/turns.py               | 6 ++++--
 tests/vibesys/orchestration/multi/test_phase_agents.py | 1 +
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/vibesys/orchestration/multi/turns.py b/src/vibesys/orchestration/multi/turns.py
index d052e4408..c32fa0141 100644
--- a/src/vibesys/orchestration/multi/turns.py
+++ b/src/vibesys/orchestration/multi/turns.py
@@ -211,8 +211,10 @@ _PHASE_ROUND_IMPLEMENTER = """
 
 This is a phase round. Follow the "Phase table and phase rounds" section of the objective
 (`{objective}`): give each target phase of the plan to a `phase` subagent, all at once, and
-coordinate them. Do not edit phase code yourself before they return. Then merge, check and
-time the merged build as that section says.
+coordinate them. Start them in the foreground (`run_in_background: false`), all Agent calls in
+one message, so that they run at the same time and you wait for all of them. A subagent stops
+when your turn ends: do not return before every subagent has returned. Do not edit phase code
+yourself before they return. Then merge, check and time the merged build as that section says.
 """
 
 _PHASE_ROUND_PLAN = """
diff --git a/tests/vibesys/orchestration/multi/test_phase_agents.py b/tests/vibesys/orchestration/multi/test_phase_agents.py
index a4ab1f0cb..765796a44 100644
--- a/tests/vibesys/orchestration/multi/test_phase_agents.py
+++ b/tests/vibesys/orchestration/multi/test_phase_agents.py
@@ -33,6 +33,7 @@ def test_a_phase_round_names_the_coordinator_duties(
     monkeypatch.setenv(MICROBENCH_FULL_ROUNDS_ENV, "0")
     plan, implement = _calls(tmp_path)
     assert "Phase table and phase rounds" in implement
+    assert "run_in_background: false" in implement and "do not return before every subagent" in implement
     assert "`phase` subagent" in implement
     assert "name the target phases" in plan
 
